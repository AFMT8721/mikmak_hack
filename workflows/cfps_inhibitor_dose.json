{
  "workflow_id": "cfps_inhibitor_dose",
  "name": "CFPS Inhibitor Dose (Part 3a)",
  "description": "Part 3a of the TEM-1 inhibitor screen: doses each of up to 8 already-expressed TEM1 wells (built by cfps_mastermix / Part 1, confirmed by cfps_sfgfp_confirmation / Part 2) with its own compound volume from a pre-arrayed compound_library plate. No nitrocefin here and no mixing step — mixing-in-place was dropped project-wide (the tip retracts fully at the end of every epipette_dispense, so a separate mix-in-place node never actually had liquid to work with). After this run, let the compound incubate with the enzyme off-robot, then add nitrocefin by hand, then run cfps_inhibitor_kinetic_read (Part 3b) to load the plate into the reader.",
  "version": "1.0.0",
  "author": "pipeline",
  "created_at": "2026-07-26T00:00:00.000Z",
